-- 3808. Find Emotionally Consistent Users
WITH user_stats AS (
    SELECT
        user_id,
        COUNT(DISTINCT content_id) AS content_count
    FROM reactions
    GROUP BY user_id
),
reaction_stats AS (
    SELECT
        user_id,
        reaction,
        COUNT(*) AS reaction_count,
        SUM(COUNT(*)) OVER (
            PARTITION BY user_id
        ) AS total_reactions
    FROM reactions
    GROUP BY user_id, reaction
),
ranked_reactions AS (
    SELECT
        user_id,
        reaction,
        total_reactions,
        reaction_count,
        ROW_NUMBER() OVER (
            PARTITION BY user_id
            ORDER BY reaction_count DESC, reaction ASC
        ) AS rn
    FROM reaction_stats
)
SELECT
    r.user_id,
    r.reaction AS dominant_reaction,
    ROUND(r.reaction_count * 1.0 / r.total_reactions, 2)
        AS reaction_ratio
FROM ranked_reactions r
JOIN user_stats u
    ON r.user_id = u.user_id
WHERE u.content_count >= 5
  AND r.rn = 1
  AND r.reaction_count * 1.0 / r.total_reactions >= 0.60
ORDER BY
    reaction_ratio DESC,
    r.user_id ASC;
